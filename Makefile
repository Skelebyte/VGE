# GNU Make workspace makefile autogenerated by Premake

ifndef config
  config=debug
endif

ifndef verbose
  SILENT = @
endif

ifeq ($(config),debug)
  vge_config = debug

else ifeq ($(config),release)
  vge_config = release

else
  $(error "invalid configuration $(config)")
endif

PROJECTS := vge

.PHONY: all clean help $(PROJECTS) 

all: $(PROJECTS)

vge:
ifneq (,$(vge_config))
	@echo "==== Building vge ($(vge_config)) ===="
	@${MAKE} --no-print-directory -C . -f vge.make config=$(vge_config)
endif

clean:
	@${MAKE} --no-print-directory -C . -f vge.make clean

help:
	@echo "Usage: make [config=name] [target]"
	@echo ""
	@echo "CONFIGURATIONS:"
	@echo "  debug"
	@echo "  release"
	@echo ""
	@echo "TARGETS:"
	@echo "   all (default)"
	@echo "   clean"
	@echo "   vge"
	@echo ""
	@echo "For more information, see https://github.com/premake/premake-core/wiki"